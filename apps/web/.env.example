# Public, browser-visible configuration only. No secrets belong here.
# development | testnet | production
NEXT_PUBLIC_APP_ENV=development
# Allow the local Anvil chain (31337). Must be false in production builds.
NEXT_PUBLIC_ENABLE_ANVIL=true
# WalletConnect Cloud project id. Without it only browser-injected wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional Base Sepolia RPC (visible to browsers — use a public/rate-limited endpoint).
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
