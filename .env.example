# ─────────────────────────────────────────────────────────────────────────────
# Contracts / deployment (read by scripts/deploy.mjs and forge). NEVER commit .env.
# Never put a private key or mnemonic here: import the deployer into Foundry's
# encrypted keystore instead:  cast wallet import forma-deployer --interactive
# ─────────────────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=
# Etherscan V2 API key (also verifies on Basescan)
ETHERSCAN_API_KEY=
# Foundry keystore account name used to sign the Base Sepolia deployment
DEPLOYER_ACCOUNT=forma-deployer

# Role holders — mandatory on Base Sepolia, default to the deployer on Anvil
ADMIN_ADDRESS=
POOL_MANAGER_ADDRESS=
REWARD_MANAGER_ADDRESS=
PAUSER_ADDRESS=

# Optional initial reward stream (wei / seconds). Defaults: 5,000,000 FORGE over 90 days.
# INITIAL_REWARDS=5000000000000000000000000
# REWARD_DURATION=7776000

# Frontend variables live in apps/web/.env.local (see apps/web/.env.example).
